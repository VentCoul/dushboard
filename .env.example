# === Дашборд: приклад конфігу. Скопіюй у .env і заповни ===

# Логін (один пароль для всього дашборда)
DASHBOARD_PASSWORD=change-me
# Секрет для підпису cookie-сесій (згенеруй: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=change-me-too

# Obsidian-міст
# Локальний шлях до git-клону віртуала (на VPS, напр. /root/dushboard/data/vault)
VAULT_PATH=data/vault
# Підпапка з проєктами/задачами всередині віртуала
VAULT_PROJECTS_DIR=Projects
# Чи робити git pull/push автоматично (1) чи працювати лише з локальними файлами (0)
VAULT_GIT_ENABLED=0

# Погода (Open-Meteo, без ключа) — координати твого міста
WEATHER_LAT=50.45
WEATHER_LON=30.52
WEATHER_CITY=Kyiv

# Крипта (CoinGecko, без ключа) — список через кому
CRYPTO_IDS=bitcoin,ethereum,solana

# GitHub
GITHUB_TOKEN=
GITHUB_USER=

# Календар (секретний iCal-URL з Google Calendar, read-only)
ICAL_URL=

# Пошта (IMAP, read-only). Для Gmail використовуй app-password.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# Telegram-боти для моніторингу: назва systemd-сервісу через кому
BOT_SERVICES=poster-bot
